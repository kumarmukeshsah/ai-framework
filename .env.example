# Environment
ENV=development
DEBUG=true

# LLM Provider Configuration
# Supported providers: openai, anthropic, ollama, azure_openai, gemini, vllm
LLM__PROVIDER=ollama
LLM__API_KEY=
LLM__API_BASE=http://localhost:11434
LLM__API_VERSION=
LLM__MODEL_NAME=llama3.1
LLM__EMBEDDING_MODEL=nomic-embed-text
LLM__MAX_TOKENS=4096
LLM__TEMPERATURE=0.7
LLM__TIMEOUT_SECONDS=60
LLM__MAX_RETRIES=3

# Vector Database Configuration
# Supported providers: qdrant, pinecone, weaviate
VECTOR_DB__PROVIDER=qdrant
VECTOR_DB__URL=http://localhost:6333
VECTOR_DB__API_KEY=
VECTOR_DB__COLLECTION_NAME=ai_framework
VECTOR_DB__EMBEDDING_DIMENSION=1536
VECTOR_DB__CHUNK_SIZE=512
VECTOR_DB__CHUNK_OVERLAP=64
VECTOR_DB__TOP_K=5
VECTOR_DB__SCORE_THRESHOLD=0.7

# API Configuration
API__HOST=0.0.0.0
API__PORT=8000
API__DEBUG=true
API__RELOAD=true
API__LOG_LEVEL=INFO

# Observability Configuration
OBSERVABILITY__ENABLED=true
OBSERVABILITY__PROMETHEUS_PORT=8001
OBSERVABILITY__ENABLE_TRACE_EXPORT=false
OBSERVABILITY__TRACE_EXPORTER_ENDPOINT=
OBSERVABILITY__SERVICE_NAME=ai-platform
OBSERVABILITY__ENVIRONMENT=development

# Security Configuration
SECURITY__RATE_LIMIT_PER_MINUTE=60
SECURITY__MAX_INPUT_LENGTH=32000
SECURITY__ENABLE_PROMPT_INJECTION_DETECTION=true
SECURITY__ENABLE_OUTPUT_FILTERING=true

# Database Configuration
DATABASE__URL=sqlite:///./ai_framework.db
DATABASE__ECHO=false